# 算电通平台配置文件
# 复制此文件为 .env 并填入实际值

# 飞书群聊ID
FEISHU_CHAT_ID=oc_your_chat_id_here

# 7个专业智能体的open_id（在飞书群成员中获取）
AGENT_POLICY_ID=ou_your_agent_id_here
AGENT_GREEN_ID=ou_your_agent_id_here
AGENT_EFFICIENCY_ID=ou_your_agent_id_here
AGENT_TRADING_ID=ou_your_agent_id_here
AGENT_FINANCE_ID=ou_your_agent_id_here
AGENT_COMPUTE_ID=ou_your_agent_id_here
AGENT_COMPLIANCE_ID=ou_your_agent_id_here

# 服务端口（可选，默认3000）
PORT=3000
